# Existing Shopify Storefront configuration — keep your current production values.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_storefront_token

# Optional: use the final production domain for the dynamic sitemap.
# If omitted, the sitemap uses the incoming production host automatically.
SITE_URL=https://your-final-domain.com
